NODE_ENV=production
HOST=127.0.0.1
PORT=3000
ORIGIN=https://frameforge.lan
FRAMEFORGE_DATA_DIR=/var/lib/frameforge
FRAMEFORGE_DATABASE_PATH=/var/lib/frameforge/frameforge.db
FRAMEFORGE_MEDIA_ROOT=/var/lib/frameforge/media
FRAMEFORGE_LINKED_MEDIA_ROOTS=/mnt/data/comfy/output
FRAMEFORGE_UPLOAD_LIMIT_MB=1024
BODY_SIZE_LIMIT=1G
