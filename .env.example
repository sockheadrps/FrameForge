# Development defaults to .data in the repository. Set these production paths on Ubuntu.
# FRAMEFORGE_DATA_DIR=/var/lib/frameforge
# FRAMEFORGE_DATABASE_PATH=/var/lib/frameforge/frameforge.db
# FRAMEFORGE_MEDIA_ROOT=/var/lib/frameforge/media
# Linux deployment example. Separate multiple approved roots with semicolons.
# FRAMEFORGE_LINKED_MEDIA_ROOTS=/mnt/data/comfy/output
# Windows examples may use a local path or an accessible WSL/network share:
# FRAMEFORGE_LINKED_MEDIA_ROOTS=D:\ComfyUI\output
FRAMEFORGE_UPLOAD_LIMIT_MB=1024
# Adapter-node request ceiling. Keep this aligned with or above the FrameForge limit.
BODY_SIZE_LIMIT=1G
HOST=127.0.0.1
PORT=3000
ORIGIN=http://localhost:3000
